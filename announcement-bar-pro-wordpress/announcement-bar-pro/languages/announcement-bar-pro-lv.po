#. Plugin Name of the plugin
#: announcement-bar-pro.php
#: includes/class-admin.php:56
#: includes/class-admin.php:253
msgid "Announcement Bar Pro"
msgstr "Announcement Bar Pro"

#. Description of the plugin
#: announcement-bar-pro.php
msgid "Announcement bars with rotating messages, schedules, countdowns and a WooCommerce free-shipping progress bar. Pro adds more bars, inline boxes, targeting, A/B tests, coupons and a GDPR e-mail sign-up."
msgstr "Paziņojumu joslas ar mainīgiem paziņojumiem, grafikiem, atpakaļskaitīšanu un WooCommerce bezmaksas piegādes progresa joslu. Pro pievieno vairāk joslu, iebūvētus blokus, mērķēšanu, A/B testus, kuponus un GDPR atbilstošu e-pasta pieteikšanos."

