{# OpenCart 3D Product Viewer — skatītājs. Tēma var pārrakstīt: catalog/view/theme/<tēma>/template/extension/module/product_3d.twig #}
<div id="product-3d" class="product-3d" data-placement="{{ viewer.placement|e }}" data-selector="{{ viewer.selector|e }}" data-image-keys="{{ viewer.image_keys|e }}"{% if viewer.placement != 'manual' %} hidden{% endif %}
  style="--p3d-height: {{ viewer.height }}px; --p3d-bg: {{ viewer.bg_color|e }}">
  <model-viewer
    src="{{ viewer.src|e }}"
    {% if viewer.ios_src %}ios-src="{{ viewer.ios_src|e }}"{% endif %}
    {% if viewer.poster %}poster="{{ viewer.poster|e }}"{% endif %}
    alt="{{ viewer.alt|e }}"
    {% if viewer.camera_controls %}camera-controls touch-action="pan-y"{% endif %}
    {% if viewer.auto_rotate %}auto-rotate auto-rotate-delay="1500" rotation-per-second="30deg"{% endif %}
    {% if viewer.camera_orbit %}camera-orbit="{{ viewer.camera_orbit|e }}"{% endif %}
    shadow-intensity="{{ viewer.shadow|e }}"
    exposure="{{ viewer.exposure|e }}"
    environment-image="neutral"
    interaction-prompt="auto"
    loading="eager"
    reveal="auto"
    {% if viewer.ar %}ar ar-modes="webxr scene-viewer quick-look" ar-scale="auto" ar-placement="floor"{% endif %}>
    {% if viewer.ar %}
    <button slot="ar-button" class="product-3d-ar" type="button">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 2 3 7v10l9 5 9-5V7z"/><path d="m3 7 9 5 9-5M12 12v10"/></svg>
      {{ viewer.text_ar|e }}
    </button>
    {% endif %}
  </model-viewer>
  <div class="product-3d-badge"><span aria-hidden="true">⟲</span> {{ viewer.text_title|e }}</div>
  <p class="product-3d-hint">{{ viewer.text_hint|e }}</p>
</div>
