{{ header }}{{ column_left }}
<div id="content" class="abp-admin">
  <link rel="stylesheet" href="{{ admin_css|e }}"/>
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-message" data-bs-toggle="tooltip" title="{{ button_save|e }}" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back|e }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }} <small class="text-muted fs-6">v{{ version|e }}</small></h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div id="abp-alerts"></div>
    <form id="form-message" action="{{ save }}" method="post" data-oc-toggle="ajax">

{# ---------- Templates (new messages only) ---------- #}
      {% if is_new %}
      <div class="card abp-card" id="abp-card-templates">
        <div class="card-header"><span class="abp-card-title"><span class="abp-ico-badge"><i class="fa-solid fa-wand-magic-sparkles"></i></span> {{ text_section_templates }} <small>{{ help_templates }}</small></span></div>
        <div class="card-body"><div class="abp-tpl-grid" id="abp-templates" role="list"></div></div>
      </div>
      {% endif %}

      {# ---------- Live preview (sticky) ---------- #}
      <div class="card abp-card abp-preview-card">
        <div class="card-header"><span class="abp-card-title"><span class="abp-ico-badge"><i class="fa-solid fa-eye"></i></span> {{ text_preview }} <small>{{ text_form }}</small></span></div>
        <div class="card-body pb-3">
          <div class="abp-pv-tools">
            <span class="abp-pv-label">{{ text_editing_language }}</span>
            <span class="abp-langs" role="group" aria-label="{{ text_editing_language|e }}">
              {% for language in languages %}<button type="button" data-abp-lang="{{ language.language_id }}" aria-pressed="false"><img src="{{ (language.image ?: 'language/' ~ language.code ~ '/' ~ language.code ~ '.png')|e }}" alt=""/> {{ language.name|e }}</button>{% endfor %}
            </span>
            <span class="abp-seg" role="group" aria-label="{{ text_preview|e }}"><button type="button" class="active" data-abp-pv="device" data-value="desktop" aria-pressed="true"><i class="fa-solid fa-desktop"></i> {{ text_preview_desktop }}</button><button type="button" data-abp-pv="device" data-value="phone" aria-pressed="false"><i class="fa-solid fa-mobile-screen"></i> {{ text_preview_phone }}</button></span>
            <span class="abp-seg" role="group" aria-label="{{ text_preview_variant|e }}"><button type="button" class="active" data-abp-pv="variant" data-value="a" aria-pressed="true">A</button><button type="button" data-abp-pv="variant" data-value="b" aria-pressed="false">B</button></span>
            <span class="abp-seg" id="abp-pv-cart" role="group" aria-label="{{ text_preview_cart|e }}"><button type="button" class="active" data-abp-pv="cart" data-value="below" aria-pressed="true">{{ text_preview_cart_below }}</button><button type="button" data-abp-pv="cart" data-value="done" aria-pressed="false">{{ text_preview_cart_done }}</button></span>
          </div>
          <div id="abp-preview-wrap"><iframe id="abp-preview-frame" title="{{ text_preview|e }}" sandbox="allow-scripts"></iframe></div>
          <p class="abp-pv-note"><i class="fa-solid fa-circle-info"></i> {{ text_preview_note }}{% if color_auto %} {{ text_preview_auto }}{% endif %} <span id="abp-pv-extra"></span></p>
          <div id="abp-contrast" class="text-warning" hidden><i class="fa-solid fa-triangle-exclamation"></i> {{ text_low_contrast }}</div>
        </div>
      </div>

      {# ---------- Content ---------- #}
      <div class="card abp-card" id="abp-card-content">
        <div class="card-header"><span class="abp-card-title"><span class="abp-ico-badge"><i class="fa-solid fa-pen"></i></span> {{ text_section_content }}</span></div>
        <div class="card-body">
          <div class="row mb-3">
            <label for="input-status" class="col-sm-2 col-form-label">{{ entry_status }}</label>
            <div class="col-sm-10">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="status" value="0"/>
                <input type="checkbox" name="status" value="1" id="input-status" class="form-check-input"{% if status %} checked{% endif %}/>
              </div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-type" class="col-sm-2 col-form-label">{{ entry_type }}</label>
            <div class="col-sm-10">
              <select name="type" id="input-type" class="form-select" style="max-width:320px;">
                {% for value in ['standard', 'free_shipping', 'tiers'] %}
                  <option value="{{ value }}"{% if type == value %} selected{% endif %}>{{ attribute(_context, 'text_type_' ~ value) }}</option>
                {% endfor %}
              </select>
              <div class="form-text">{{ help_type }}</div>
              <div id="error-type" class="invalid-feedback"></div>
            </div>
          </div>
          <p class="abp-hint" data-abp-show="type=free_shipping"><i class="fa-regular fa-lightbulb"></i> {{ help_shipping_text }}</p>
          <p class="abp-hint" data-abp-show="type=tiers"><i class="fa-regular fa-lightbulb"></i> {{ help_tiers_text }}</p>
          {% for language in languages %}
            {% set lid = language.language_id %}
            <div class="abp-lang-pane" data-lang="{{ lid }}">
              <div class="row mb-3 required">
                <label for="input-text-{{ lid }}" class="col-sm-2 col-form-label">{{ entry_text }}<span class="abp-lang-tag">{{ language.code|e }}</span></label>
                <div class="col-sm-10">
                  <textarea name="message_description[{{ lid }}][text]" rows="2" maxlength="{{ max_text }}" id="input-text-{{ lid }}" class="form-control abp-text">{{ message_description[lid].text|e }}</textarea>
                  <div class="form-text">{{ allow_html ? help_text_html : help_text_plain }} {{ help_countdown_placeholder }} {{ help_lang_fallback }}</div>
                  <div id="error-text-{{ lid }}" class="invalid-feedback"></div>
                </div>
              </div>
              <div class="row mb-3">
                <label for="input-mobile-text-{{ lid }}" class="col-sm-2 col-form-label">{{ entry_mobile_text }}</label>
                <div class="col-sm-10">
                  <textarea name="message_description[{{ lid }}][mobile_text]" rows="2" maxlength="{{ max_text }}" id="input-mobile-text-{{ lid }}" class="form-control abp-mobile-text">{{ message_description[lid].mobile_text|e }}</textarea>
                  <div class="form-text">{{ help_mobile_text }}</div>
                  <div id="error-mobile-text-{{ lid }}" class="invalid-feedback"></div>
                </div>
              </div>
            </div>
          {% endfor %}
          <div class="row mb-3">
            <label for="input-icon" class="col-sm-2 col-form-label">{{ entry_icon }}</label>
            <div class="col-sm-10">
              <div class="input-group" style="max-width:340px;">
                <span class="input-group-text"><i id="abp-icon-preview" class="fa-solid fa-question"></i></span>
                <input type="text" name="icon" value="{{ icon|e }}" maxlength="64" placeholder="fa-truck" id="input-icon" class="form-control"/>
              </div>
              <div class="form-text">{{ help_icon }}</div>
              <div id="error-icon" class="invalid-feedback"></div>
            </div>
          </div>
        </div>
      </div>

      {# ---------- Button & coupon ---------- #}
      <div class="card abp-card" id="abp-card-button">
        <div class="card-header"><span class="abp-card-title"><span class="abp-ico-badge"><i class="fa-solid fa-hand-pointer"></i></span> {{ text_section_button }}</span></div>
        <div class="card-body">
          {% for language in languages %}
            {% set lid = language.language_id %}
            <div class="abp-lang-pane" data-lang="{{ lid }}">
              <div class="row mb-3">
                <label for="input-link-text-{{ lid }}" class="col-sm-2 col-form-label">{{ entry_link_text }}<span class="abp-lang-tag">{{ language.code|e }}</span></label>
                <div class="col-sm-10">
                  <input type="text" name="message_description[{{ lid }}][link_text]" value="{{ message_description[lid].link_text|e }}" maxlength="{{ max_link_text }}" id="input-link-text-{{ lid }}" class="form-control abp-link-text"/>
                  <div class="form-text">{{ help_link_text }}</div>
                  <div id="error-link-text-{{ lid }}" class="invalid-feedback"></div>
                </div>
              </div>
            </div>
          {% endfor %}
          <div class="row mb-3">
            <label for="input-link" class="col-sm-2 col-form-label">{{ entry_link }}</label>
            <div class="col-sm-10">
              <input type="text" name="link" value="{{ link|e }}" maxlength="255" placeholder="https://… / index.php?route=…" id="input-link" class="form-control"/>
              <div class="form-check mt-1">
                <input type="checkbox" name="link_new_tab" value="1" id="input-link-new-tab" class="form-check-input"{% if link_new_tab %} checked{% endif %}/>
                <label for="input-link-new-tab" class="form-check-label">{{ entry_link_new_tab }}</label>
              </div>
              <div class="form-text">{{ help_link }}</div>
              <div id="error-link" class="invalid-feedback"></div>
            </div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_button_style }}</label>
            <div class="col-sm-10">
              <span class="abp-seg" role="radiogroup" aria-label="{{ entry_button_style|e }}">
                {% for value in ['filled', 'outline', 'link'] %}<input type="radio" name="button_style" id="input-button-style-{{ value }}" value="{{ value }}"{% if button_style == value %} checked{% endif %}/><label for="input-button-style-{{ value }}">{{ attribute(_context, 'text_button_' ~ value) }}</label>{% endfor %}
              </span>
              <div id="error-button-style" class="invalid-feedback"></div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-coupon-id" class="col-sm-2 col-form-label">{{ entry_coupon_id }}</label>
            <div class="col-sm-10">
              <div class="abp-chips" id="input-coupon-id" data-abp-ac="coupon" data-name="opt[coupon_id]" data-max="1">
                {% for id, name in coupon_chip %}<span class="abp-chip"><span class="abp-chip-text">{{ name|e }}</span><input type="hidden" name="opt[coupon_id]" value="{{ id }}"/><button type="button" class="abp-chip-x" aria-label="{{ button_remove|e }}: {{ name|e }}">&times;</button></span>{% endfor %}
                <input type="text" class="abp-ac-input" placeholder="{{ text_autocomplete_coupon|e }}" autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-label="{{ entry_coupon_id|e }}"/>
                <div class="abp-ac-menu" role="listbox" hidden></div>
              </div>
              <div class="form-text">{{ help_coupon_id }}</div>
              <div id="error-opt-coupon-id" class="invalid-feedback"></div>
            </div>
          </div>
          <div class="row mb-3" data-abp-show="!opt[coupon_id]">
            <label for="input-coupon" class="col-sm-2 col-form-label">{{ entry_coupon }}</label>
            <div class="col-sm-10">
              <div class="input-group" style="max-width:300px;">
                <span class="input-group-text"><i class="fa-solid fa-ticket"></i></span>
                <input type="text" name="coupon" value="{{ coupon|e }}" maxlength="32" placeholder="SPRING10" id="input-coupon" class="form-control" style="text-transform:uppercase;font-family:monospace;letter-spacing:.06em;" autocomplete="off"/>
              </div>
              <div class="form-text">{{ help_coupon }}</div>
              <div id="error-coupon" class="invalid-feedback"></div>
            </div>
          </div>
        </div>
      </div>

      {# ---------- Free shipping / tiered goals ---------- #}
      <div class="card abp-card" id="abp-card-shipping" data-abp-show="type=free_shipping|tiers">
        <div class="card-header"><span class="abp-card-title"><span class="abp-ico-badge"><i class="fa-solid fa-truck-fast"></i></span> {{ text_section_goal }}</span></div>
        <div class="card-body">
          <div data-abp-show="type=free_shipping">
            <div class="row mb-3">
              <label class="col-sm-2 col-form-label" for="input-fs-oc">{{ entry_fs_oc }}</label>
              <div class="col-sm-10">
                <div class="form-check"><input type="checkbox" name="opt[fs_oc]" id="input-fs-oc" value="1" class="form-check-input"{% if opt.fs_oc %} checked{% endif %}/> <label for="input-fs-oc" class="form-check-label">{{ text_fs_oc }}</label></div>
                <span class="abp-help">{{ help_fs_oc|format(oc_free_shipping.total, oc_free_shipping.status ? text_enabled : text_disabled)|e }}</span>
              </div>
            </div>
            <div class="row mb-3 required" data-abp-show="!opt[fs_oc]">
              <label class="col-sm-2 col-form-label" for="input-threshold">{{ entry_threshold }}</label>
              <div class="col-sm-10">
                <div class="input-group" style="max-width:220px;">
                  <input type="text" inputmode="decimal" name="threshold" value="{{ threshold|e }}" placeholder="50.00" id="input-threshold" class="form-control"/>
                  <span class="input-group-text">{{ currency_code|e }}</span>
                </div>
                <span class="abp-help">{{ help_threshold|format(currency_code)|e }}</span>
                <div id="error-threshold" class="invalid-feedback"></div>
              </div>
            </div>
            <div class="row mb-3">
              <label class="col-sm-2 col-form-label">{{ entry_fs_zones }}</label>
              <div class="col-sm-10">
                <div class="table-responsive">
                  <table class="table table-condensed abp-rows" id="abp-zone-rows">
                    <thead><tr><td>{{ entry_country }}</td><td>{{ entry_zone }}</td><td>{{ entry_amount }} ({{ currency_code|e }})</td></tr></thead>
                    <tbody>
                      {% for row in fs_zone_rows %}
                      {% set i = loop.index0 %}
                      <tr>
                        <td><select name="opt[fs_zones][{{ i }}][country_id]" class="form-select abp-zone-country" aria-label="{{ entry_country|e }}"><option value="0">—</option>{% for id, name in country_list %}<option value="{{ id }}"{% if id == row.country_id %} selected{% endif %}>{{ name|e }}</option>{% endfor %}</select></td>
                        <td><select name="opt[fs_zones][{{ i }}][zone_id]" class="form-select abp-zone-zone" aria-label="{{ entry_zone|e }}"><option value="0">{{ text_all_zones }}</option>{% for zone in row.zones %}<option value="{{ zone.id }}"{% if zone.id == row.zone_id %} selected{% endif %}>{{ zone.name|e }}</option>{% endfor %}</select></td>
                        <td><input type="text" inputmode="decimal" name="opt[fs_zones][{{ i }}][amount]" value="{{ row.amount|e }}" class="form-control" aria-label="{{ entry_amount|e }}"/></td>
                      </tr>
                      {% endfor %}
                    </tbody>
                  </table>
                </div>
                <button type="button" class="btn btn-default btn-sm" data-abp-add-row="#abp-zone-rows"><i class="fa-solid fa-plus"></i> {{ button_add_row }}</button>
                <span class="abp-help">{{ help_fs_zones }}</span>
                <div id="error-opt-fs-zones" class="invalid-feedback"></div>
              </div>
            </div>
            <div class="row mb-3">
              <label class="col-sm-2 col-form-label">{{ entry_fs_currencies }}</label>
              <div class="col-sm-10">
                {% if currency_rows %}
                <div class="abp-cur-grid">
                  {% for c in currency_rows %}<div class="input-group"><input type="text" inputmode="decimal" name="opt[fs_currencies][{{ c.code|e }}]" value="{{ c.amount|e }}" class="form-control" aria-label="{{ entry_fs_currencies|e }} {{ c.code|e }}" placeholder="—"/><span class="input-group-text" title="{{ c.title|e }}">{{ c.code|e }}</span></div>{% endfor %}
                </div>
                <span class="abp-help">{{ help_fs_currencies }}</span>
                {% else %}
                <span class="abp-help">{{ text_one_currency }}</span>
                {% endif %}
                <div id="error-opt-fs-currencies" class="invalid-feedback"></div>
              </div>
            </div>
          </div>
          <div data-abp-show="type=tiers">
            <div class="row mb-3 required">
              <label class="col-sm-2 col-form-label">{{ entry_tiers }}</label>
              <div class="col-sm-10">
                <div class="table-responsive">
                  <table class="table table-condensed abp-rows abp-tiers">
                    <thead><tr><td style="width:1px;">#</td><td style="width:150px;">{{ entry_amount }} ({{ currency_code|e }})</td><td>{{ entry_tier_label }}</td><td>{{ entry_tier_text }}</td></tr></thead>
                    <tbody>
                      {% for i in 0..4 %}
                      <tr>
                        <td class="abp-muted">{{ i + 1 }}</td>
                        <td><input type="text" inputmode="decimal" name="opt[tiers][]" value="{{ tier_rows[i]|e }}" class="form-control abp-tier-amount" aria-label="{{ text_tier|format(i + 1)|e }} — {{ entry_amount|e }}"/></td>
                        <td>{% for language in languages %}{% set lid = language.language_id %}<span class="abp-lang-pane abp-lang-inline" data-lang="{{ lid }}"><input type="text" name="message_description[{{ lid }}][tier_label][]" value="{{ message_description[lid].tier_label[i]|e }}" maxlength="160" class="form-control" aria-label="{{ text_tier|format(i + 1)|e }} — {{ entry_tier_label|e }} ({{ language.code|e }})"/></span>{% endfor %}</td>
                        <td>{% for language in languages %}{% set lid = language.language_id %}<span class="abp-lang-pane abp-lang-inline" data-lang="{{ lid }}"><input type="text" name="message_description[{{ lid }}][tier_text][]" value="{{ message_description[lid].tier_text[i]|e }}" maxlength="300" class="form-control" aria-label="{{ text_tier|format(i + 1)|e }} — {{ entry_tier_text|e }} ({{ language.code|e }})"/></span>{% endfor %}</td>
                      </tr>
                      {% endfor %}
                    </tbody>
                  </table>
                </div>
                <span class="abp-help">{{ help_tiers }}</span>
                <div id="error-opt-tiers" class="invalid-feedback"></div>
                {% for language in languages %}<div id="error-tier-label-{{ language.language_id }}" class="invalid-feedback"></div><div id="error-tier-text-{{ language.language_id }}" class="invalid-feedback"></div>{% endfor %}
              </div>
            </div>
          </div>
          {% for language in languages %}
          {% set lid = language.language_id %}
          <div class="abp-lang-pane" data-lang="{{ lid }}">
            <div class="row mb-3 required">
              <label class="col-sm-2 col-form-label" for="input-success-text{{ lid }}">{{ entry_success_text }}<span class="abp-lang-tag">{{ language.code|e }}</span></label>
              <div class="col-sm-10">
                <textarea name="message_description[{{ lid }}][success_text]" rows="2" maxlength="{{ max_text }}" id="input-success-text{{ lid }}" class="form-control">{{ message_description[lid].success_text|e }}</textarea>
                <span class="abp-help">{{ help_success_text }}</span>
                <div id="error-success-text-{{ lid }}" class="invalid-feedback"></div>
              </div>
            </div>
          </div>
          {% endfor %}
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label" for="input-progress-bar">{{ entry_progress_bar }}</label>
            <div class="col-sm-10">
              <div class="form-check form-switch form-switch-lg"><input type="hidden" name="progress_bar" value="0"/><input type="checkbox" name="progress_bar" id="input-progress-bar" value="1" class="form-check-input"{% if progress_bar %} checked{% endif %}/> <label for="input-progress-bar" class="form-check-label">{{ text_progress_bar }}</label></div>
            </div>
          </div>
        </div>
      </div>

      {# ---------- E-mail sign-up ---------- #}
      <div class="card abp-card" id="abp-card-email">
        <div class="card-header"><span class="abp-card-title"><span class="abp-ico-badge"><i class="fa-solid fa-envelope"></i></span> {{ text_section_email }}</span></div>
        <div class="card-body">
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label" for="input-email">{{ entry_email_capture }}</label>
            <div class="col-sm-10">
              <div class="form-check"><input type="checkbox" name="opt[email]" id="input-email" value="1" class="form-check-input"{% if opt.email %} checked{% endif %}/> <label for="input-email" class="form-check-label">{{ text_email_capture }}</label></div>
              <span class="abp-help">{{ help_email_capture }}</span>
            </div>
          </div>
          <div data-abp-show="opt[email]">
            {% for language in languages %}
            {% set lid = language.language_id %}
            <div class="abp-lang-pane" data-lang="{{ lid }}">
              {% for field in ['email_placeholder', 'email_button', 'email_consent', 'email_success'] %}
              <div class="row mb-3">
                <label class="col-sm-2 col-form-label" for="input-{{ field }}{{ lid }}">{{ attribute(_context, 'entry_' ~ field) }}<span class="abp-lang-tag">{{ language.code|e }}</span></label>
                <div class="col-sm-10">
                  <input type="text" name="message_description[{{ lid }}][{{ field }}]" value="{{ attribute(message_description[lid], field)|e }}" maxlength="{{ field == 'email_consent' ? 300 : 160 }}" id="input-{{ field }}{{ lid }}" class="form-control" placeholder="{{ attribute(_context, 'text_' ~ field ~ '_default')|e }}"/>
                  <div id="error-{{ field|replace({'_': '-'}) }}-{{ lid }}" class="invalid-feedback"></div>
                </div>
              </div>
              {% endfor %}
            </div>
            {% endfor %}
            <p class="abp-hint"><i class="fa-solid fa-shield-halved"></i> {{ help_email_texts }}</p>
          </div>
        </div>
      </div>

      {# ---------- A/B test ---------- #}
      <div class="card abp-card" id="abp-card-ab">
        <div class="card-header"><span class="abp-card-title"><span class="abp-ico-badge"><i class="fa-solid fa-shuffle"></i></span> {{ text_section_ab }}</span></div>
        <div class="card-body">
          <div class="row mb-3">
            <label for="input-ab-test" class="col-sm-2 col-form-label">{{ entry_ab_test }}</label>
            <div class="col-sm-10">
              <div class="form-check form-switch form-switch-lg">
                <input type="checkbox" name="ab_test" value="1" id="input-ab-test" class="form-check-input"{% if ab_test %} checked{% endif %}/>
                <label for="input-ab-test" class="form-check-label ms-1" style="font-size:14px;">{{ text_ab_enable }}</label>
              </div>
              <div class="form-text">{{ help_ab }}</div>
            </div>
          </div>
          <div data-abp-show="ab_test">
            {% for language in languages %}
              {% set lid = language.language_id %}
              <div class="abp-lang-pane" data-lang="{{ lid }}">
                <div class="row mb-3 required">
                  <label for="input-text-b-{{ lid }}" class="col-sm-2 col-form-label">{{ entry_text_b }}<span class="abp-lang-tag">{{ language.code|e }}</span></label>
                  <div class="col-sm-10">
                    <textarea name="message_description[{{ lid }}][text_b]" rows="2" maxlength="{{ max_text }}" id="input-text-b-{{ lid }}" class="form-control">{{ message_description[lid].text_b|e }}</textarea>
                    <div id="error-text-b-{{ lid }}" class="invalid-feedback"></div>
                  </div>
                </div>
                <div class="row mb-3">
                  <label for="input-mobile-text-b-{{ lid }}" class="col-sm-2 col-form-label">{{ entry_mobile_text_b }}</label>
                  <div class="col-sm-10">
                    <textarea name="message_description[{{ lid }}][mobile_text_b]" rows="2" maxlength="{{ max_text }}" id="input-mobile-text-b-{{ lid }}" class="form-control">{{ message_description[lid].mobile_text_b|e }}</textarea>
                    <div id="error-mobile-text-b-{{ lid }}" class="invalid-feedback"></div>
                  </div>
                </div>
                <div class="row mb-3">
                  <label for="input-link-text-b-{{ lid }}" class="col-sm-2 col-form-label">{{ entry_link_text_b }}</label>
                  <div class="col-sm-10">
                    <input type="text" name="message_description[{{ lid }}][link_text_b]" value="{{ message_description[lid].link_text_b|e }}" maxlength="{{ max_link_text }}" id="input-link-text-b-{{ lid }}" class="form-control"/>
                    <div class="form-text">{{ help_link_text_b }}</div>
                    <div id="error-link-text-b-{{ lid }}" class="invalid-feedback"></div>
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
        </div>
      </div>

      {# ---------- Placement & behaviour ---------- #}
      <div class="card abp-card" id="abp-card-behaviour">
        <div class="card-header"><span class="abp-card-title"><span class="abp-ico-badge"><i class="fa-solid fa-table-cells-large"></i></span> {{ text_section_behaviour }}</span></div>
        <div class="card-body">
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_placement }}</label>
            <div class="col-sm-10">
              <div class="abp-places" role="radiogroup" aria-label="{{ entry_placement|e }}">
                {% for value in placements %}
                {% set key = value == '' ? 'default' : value %}
                <div class="abp-place-opt"><input type="radio" name="placement" id="input-placement-{{ key }}" value="{{ value }}"{% if placement == value %} checked{% endif %}/><label for="input-placement-{{ key }}"><span class="abp-pl-ico abp-pl-{{ key }}" aria-hidden="true"><i></i></span><span class="abp-name">{{ attribute(_context, 'text_placement_' ~ key) }}</span></label></div>
                {% endfor %}
              </div>
              <span class="abp-help">{{ help_placement }}</span>
              <div id="error-placement" class="invalid-feedback"></div>
            </div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label" for="input-priority">{{ entry_priority }}</label>
            <div class="col-sm-10">
              <input type="number" min="0" max="100" name="priority" value="{{ priority|e }}" id="input-priority" class="form-control abp-num"/>
              <span class="abp-help">{{ help_priority }}</span>
              <div id="error-priority" class="invalid-feedback"></div>
            </div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label" for="input-trigger">{{ entry_trigger }}</label>
            <div class="col-sm-10">
              <div class="abp-inline-fields">
                <select name="opt[trigger]" id="input-trigger" class="form-select" style="max-width:260px;">
                  {% for value in ['none', 'delay', 'scroll', 'exit'] %}<option value="{{ value }}"{% if opt.trigger == value %} selected{% endif %}>{{ attribute(_context, 'text_trigger_' ~ value) }}</option>{% endfor %}
                </select>
                <span data-abp-show="opt[trigger]=delay|scroll" class="abp-inline-fields"><input type="number" min="1" name="opt[trigger_value]" value="{{ opt.trigger_value ? opt.trigger_value|e : '' }}" id="input-trigger-value" class="form-control abp-num" aria-label="{{ entry_trigger_value|e }}"/><span class="abp-unit" data-abp-show="opt[trigger]=delay">{{ text_seconds }}</span><span class="abp-unit" data-abp-show="opt[trigger]=scroll">%</span></span>
              </div>
              <span class="abp-help">{{ help_trigger }}</span>
              <div id="error-opt-trigger" class="invalid-feedback"></div>
            </div>
          </div>
        </div>
      </div>

      {# ---------- Schedule ---------- #}
      <div class="card abp-card" id="abp-card-schedule">
        <div class="card-header"><span class="abp-card-title"><span class="abp-ico-badge"><i class="fa-regular fa-calendar"></i></span> {{ text_section_schedule }}</span></div>
        <div class="card-body">
          {% for key in ['date_start', 'date_end'] %}
            <div class="row mb-3">
              <label for="input-{{ key|replace({'_': '-'}) }}" class="col-sm-2 col-form-label">{{ attribute(_context, 'entry_' ~ key) }}</label>
              <div class="col-sm-10">
                <input type="datetime-local" name="{{ key }}" value="{{ attribute(_context, key)|e }}" id="input-{{ key|replace({'_': '-'}) }}" class="form-control" style="max-width:260px;"/>
                {% if key == 'date_end' %}
                  <div class="form-check mt-1">
                    <input type="checkbox" name="end_all_day" value="1" id="input-end-all-day" class="form-check-input"{% if end_all_day %} checked{% endif %}/>
                    <label for="input-end-all-day" class="form-check-label">{{ entry_end_all_day }}</label>
                  </div>
                {% endif %}
                <div class="form-text">{{ help_dates }}</div>
                <div id="error-{{ key|replace({'_': '-'}) }}" class="invalid-feedback"></div>
              </div>
            </div>
          {% endfor %}
          <div class="row mb-3">
            <label for="input-countdown" class="col-sm-2 col-form-label">{{ entry_countdown }}</label>
            <div class="col-sm-10">
              <div class="form-check form-switch form-switch-lg">
                <input type="checkbox" name="countdown" value="1" id="input-countdown" class="form-check-input"{% if countdown %} checked{% endif %}/>
              </div>
              <div class="form-text">{{ help_countdown }}</div>
              <div id="error-countdown" class="invalid-feedback"></div>
            </div>
          </div>
          <div class="row mb-3" data-abp-show="countdown">
            <label for="input-recur" class="col-sm-2 col-form-label">{{ entry_recur }}</label>
            <div class="col-sm-10">
              <div class="abp-inline-fields">
                <select name="opt[recur]" id="input-recur" class="form-select" style="max-width:280px;">
                  {% for value in ['', 'daily', 'weekly'] %}<option value="{{ value }}"{% if opt.recur == value %} selected{% endif %}>{{ attribute(_context, 'text_recur_' ~ (value == '' ? 'end' : value)) }}</option>{% endfor %}
                </select>
                <span data-abp-show="opt[recur]=weekly"><select name="opt[recur_day]" class="form-select" aria-label="{{ entry_recur_day|e }}">{% for day in 1..7 %}<option value="{{ day }}"{% if opt.recur_day == day %} selected{% endif %}>{{ attribute(_context, 'text_wd_' ~ day) }}</option>{% endfor %}</select></span>
                <span data-abp-show="opt[recur]=daily|weekly" class="abp-inline-fields"><span>{{ text_at }}</span><input type="time" name="opt[recur_time]" value="{{ opt.recur_time|e }}" class="form-control" aria-label="{{ entry_recur_time|e }}"/></span>
              </div>
              <div data-abp-show="opt[recur]=daily" class="abp-recur-skip">
                <span class="abp-sub-label">{{ entry_recur_skip }}</span>
                <div class="abp-days" role="group" aria-label="{{ entry_recur_skip|e }}">
                  {% for day in recur_skip_list %}<label class="abp-day"><input type="checkbox" name="opt[recur_skip][]" value="{{ day.value }}"{% if day.checked %} checked{% endif %}/><span>{{ day.name|e }}</span></label>{% endfor %}
                </div>
              </div>
              <div class="form-text">{{ help_recur }}</div>
              <div id="error-opt-recur" class="invalid-feedback"></div>
            </div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_weekdays }}</label>
            <div class="col-sm-10">
              <div class="abp-days" id="input-weekdays" role="group" aria-label="{{ entry_weekdays|e }}">
                {% for day in weekday_list %}<label class="abp-day"><input type="checkbox" name="weekdays[]" value="{{ day.value }}"{% if day.checked %} checked{% endif %}/><span>{{ day.name|e }}</span></label>{% endfor %}
              </div>
              <div class="form-text">{{ help_weekdays }}</div>
              <div id="error-weekdays" class="invalid-feedback"></div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-time-start" class="col-sm-2 col-form-label">{{ entry_time }}</label>
            <div class="col-sm-10">
              <div class="abp-time">
                <span>{{ text_time_from }}</span><input type="time" name="time_start" value="{{ time_start|e }}" id="input-time-start" class="form-control"/>
                <span>{{ text_time_to }}</span><input type="time" name="time_end" value="{{ time_end|e }}" id="input-time-end" class="form-control" aria-label="{{ entry_time|e }} {{ text_time_to|e }}"/>
              </div>
              <div class="form-text">{{ help_time }}</div>
              <div id="error-time-start" class="invalid-feedback"></div>
            </div>
          </div>
        </div>
      </div>

      {# ---------- Targeting ---------- #}
      <div class="card abp-card" id="abp-card-targeting">
        <div class="card-header"><span class="abp-card-title"><span class="abp-ico-badge"><i class="fa-solid fa-crosshairs"></i></span> {{ text_section_targeting }}</span></div>
        <div class="card-body">
          <div class="row mb-3">
            <label for="input-device" class="col-sm-2 col-form-label">{{ entry_device }}</label>
            <div class="col-sm-10">
              <select name="device" id="input-device" class="form-select">
                {% for value in ['all', 'desktop', 'mobile'] %}
                  <option value="{{ value }}"{% if device == value %} selected{% endif %}>{{ attribute(_context, 'text_device_' ~ value) }}</option>
                {% endfor %}
              </select>
              <div class="form-text">{{ help_device }}</div>
              <div id="error-device" class="invalid-feedback"></div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-page-mode" class="col-sm-2 col-form-label">{{ entry_page_mode }}</label>
            <div class="col-sm-10">
              <select name="page_mode" id="input-page-mode" class="form-select">
                {% for value in ['all', 'home', 'include', 'exclude'] %}
                  <option value="{{ value }}"{% if page_mode == value %} selected{% endif %}>{{ attribute(_context, 'text_page_' ~ value) }}</option>
                {% endfor %}
              </select>
              <div id="error-page-mode" class="invalid-feedback"></div>
            </div>
          </div>
          <div class="row mb-3" id="abp-routes-group" data-abp-show="page_mode=include|exclude">
            <label for="input-page-routes" class="col-sm-2 col-form-label">{{ entry_page_routes }}</label>
            <div class="col-sm-10">
              <textarea name="page_routes" rows="4" id="input-page-routes" placeholder="product/product&#10;product/category&#10;checkout/*" class="form-control">{{ page_routes|e }}</textarea>
              <div class="form-text">{{ help_routes }}</div>
              <div id="error-page-routes" class="invalid-feedback"></div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-categories" class="col-sm-2 col-form-label">{{ entry_categories }}</label>
            <div class="col-sm-10">
              <div class="abp-chips" id="input-categories" data-abp-ac="category" data-name="categories[]">
                {% for id, name in category_chips %}<span class="abp-chip"><span class="abp-chip-text">{{ name|e }}</span><input type="hidden" name="categories[]" value="{{ id }}"/><button type="button" class="abp-chip-x" aria-label="{{ button_remove|e }}: {{ name|e }}">&times;</button></span>{% endfor %}
                <input type="text" class="abp-ac-input" placeholder="{{ text_autocomplete|e }}" autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-label="{{ entry_categories|e }}"/>
                <div class="abp-ac-menu" role="listbox" hidden></div>
              </div>
              <div id="error-categories" class="invalid-feedback"></div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-products" class="col-sm-2 col-form-label">{{ entry_products }}</label>
            <div class="col-sm-10">
              <div class="abp-chips" id="input-products" data-abp-ac="product" data-name="products[]">
                {% for id, name in product_chips %}<span class="abp-chip"><span class="abp-chip-text">{{ name|e }}</span><input type="hidden" name="products[]" value="{{ id }}"/><button type="button" class="abp-chip-x" aria-label="{{ button_remove|e }}: {{ name|e }}">&times;</button></span>{% endfor %}
                <input type="text" class="abp-ac-input" placeholder="{{ text_autocomplete|e }}" autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-label="{{ entry_products|e }}"/>
                <div class="abp-ac-menu" role="listbox" hidden></div>
              </div>
              <div class="form-text">{{ help_targeting }}</div>
              <div id="error-products" class="invalid-feedback"></div>
            </div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_store }}</label>
            <div class="col-sm-10">
              {% if orphaned.stores %}<div class="alert alert-warning py-2"><i class="fa-solid fa-triangle-exclamation"></i> {{ text_orphan_stores }}</div>{% endif %}
              <div id="input-stores" class="form-control p-2" style="max-height:140px;overflow:auto;">
                {% for store in store_list %}
                  <div class="form-check">
                    <input type="checkbox" name="stores[]" value="{{ store.store_id }}" id="input-store-{{ store.store_id }}" class="form-check-input"{% if store.store_id in stores %} checked{% endif %}/>
                    <label for="input-store-{{ store.store_id }}" class="form-check-label">{{ store.name }}</label>
                  </div>
                {% endfor %}
              </div>
              <div class="form-text">{{ help_empty_all }}</div>
              <div id="error-stores" class="invalid-feedback"></div>
            </div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_customer_group }}</label>
            <div class="col-sm-10">
              {% if orphaned.customer_groups %}<div class="alert alert-warning py-2"><i class="fa-solid fa-triangle-exclamation"></i> {{ text_orphan_customer_groups }}</div>{% endif %}
              <div id="input-customer-groups" class="form-control p-2" style="max-height:140px;overflow:auto;">
                {% for group in customer_group_list %}
                  <div class="form-check">
                    <input type="checkbox" name="customer_groups[]" value="{{ group.customer_group_id }}" id="input-customer-group-{{ group.customer_group_id }}" class="form-check-input"{% if group.customer_group_id in customer_groups %} checked{% endif %}/>
                    <label for="input-customer-group-{{ group.customer_group_id }}" class="form-check-label">{{ group.name }}</label>
                  </div>
                {% endfor %}
              </div>
              <div class="form-text">{{ help_empty_all }}</div>
              <div id="error-customer-groups" class="invalid-feedback"></div>
            </div>
          </div>
        </div>
      </div>

      {# ---------- Audience: country, campaign, new / returning ---------- #}
      <div class="card abp-card" id="abp-card-audience">
        <div class="card-header"><span class="abp-card-title"><span class="abp-ico-badge"><i class="fa-solid fa-globe"></i></span> {{ text_section_audience }}</span></div>
        <div class="card-body">
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label" for="input-countries-mode">{{ entry_countries }}</label>
            <div class="col-sm-10">
              <select name="opt[countries_mode]" id="input-countries-mode" class="form-select" style="max-width:320px;">
                {% for value in ['all', 'include', 'exclude'] %}<option value="{{ value }}"{% if opt.countries_mode == value %} selected{% endif %}>{{ attribute(_context, 'text_countries_' ~ value) }}</option>{% endfor %}
              </select>
              <div class="abp-chips" id="input-countries" data-abp-ac="country" data-name="opt[countries][]" data-abp-show="opt[countries_mode]=include|exclude" style="margin-top:8px;">
                {% for id, name in country_chips %}<span class="abp-chip"><span class="abp-chip-text">{{ name|e }}</span><input type="hidden" name="opt[countries][]" value="{{ id }}"/><button type="button" class="abp-chip-x" aria-label="{{ button_remove|e }}: {{ name|e }}">&times;</button></span>{% endfor %}
                <input type="text" class="abp-ac-input" placeholder="{{ text_autocomplete|e }}" autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-label="{{ entry_countries|e }}"/>
                <div class="abp-ac-menu" role="listbox" hidden></div>
              </div>
              <span class="abp-help">{{ help_countries }}</span>
              <div id="error-opt-countries" class="invalid-feedback"></div>
            </div>
          </div>
          {% for key in ['utm_source', 'utm_medium', 'utm_campaign', 'referrer'] %}
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label" for="input-{{ key }}">{{ attribute(_context, 'entry_' ~ key) }}</label>
            <div class="col-sm-10">
              <input type="text" name="opt[{{ key }}]" value="{{ attribute(opt, key)|e }}" id="input-{{ key }}" class="form-control" placeholder="{{ key == 'referrer' ? 'facebook.com, instagram.com' : (key == 'utm_source' ? 'newsletter, google' : (key == 'utm_medium' ? 'email, cpc' : 'black-friday')) }}" autocomplete="off" spellcheck="false"/>
              {% if loop.last %}<span class="abp-help">{{ help_campaign }}</span>{% endif %}
              <div id="error-opt-{{ key|replace({'_': '-'}) }}" class="invalid-feedback"></div>
            </div>
          </div>
          {% endfor %}
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label" for="input-visitor">{{ entry_visitor }}</label>
            <div class="col-sm-10">
              <select name="opt[visitor]" id="input-visitor" class="form-select" style="max-width:320px;">
                {% for value in ['all', 'new', 'returning'] %}<option value="{{ value }}"{% if opt.visitor == value %} selected{% endif %}>{{ attribute(_context, 'text_visitor_' ~ value) }}</option>{% endfor %}
              </select>
              <span class="abp-help">{{ help_visitor }}</span>
              <div id="error-opt-visitor" class="invalid-feedback"></div>
            </div>
          </div>
        </div>
      </div>

      {# ---------- Cart conditions ---------- #}
      <div class="card abp-card" id="abp-card-cart">
        <div class="card-header"><span class="abp-card-title"><span class="abp-ico-badge"><i class="fa-solid fa-cart-shopping"></i></span> {{ text_section_cart }}</span></div>
        <div class="card-body">
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label" for="input-cart-subtotal-min">{{ entry_cart_subtotal }}</label>
            <div class="col-sm-10">
              <div class="abp-inline-fields">
                <span>{{ text_min }}</span><input type="text" inputmode="decimal" name="opt[cart_subtotal_min]" value="{{ opt.cart_subtotal_min|e }}" id="input-cart-subtotal-min" class="form-control abp-num"/>
                <span>{{ text_max }}</span><input type="text" inputmode="decimal" name="opt[cart_subtotal_max]" value="{{ opt.cart_subtotal_max|e }}" class="form-control abp-num" aria-label="{{ entry_cart_subtotal|e }} {{ text_max|e }}"/>
                <span class="abp-unit">{{ currency_code|e }}</span>
              </div>
              <div id="error-opt-cart-subtotal-min" class="invalid-feedback"></div>
              <div id="error-opt-cart-subtotal-max" class="invalid-feedback"></div>
            </div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label" for="input-cart-qty-min">{{ entry_cart_qty }}</label>
            <div class="col-sm-10">
              <div class="abp-inline-fields">
                <span>{{ text_min }}</span><input type="number" min="0" name="opt[cart_qty_min]" value="{{ opt.cart_qty_min|e }}" id="input-cart-qty-min" class="form-control abp-num"/>
                <span>{{ text_max }}</span><input type="number" min="0" name="opt[cart_qty_max]" value="{{ opt.cart_qty_max|e }}" class="form-control abp-num" aria-label="{{ entry_cart_qty|e }} {{ text_max|e }}"/>
              </div>
              <div id="error-opt-cart-qty-min" class="invalid-feedback"></div>
              <div id="error-opt-cart-qty-max" class="invalid-feedback"></div>
            </div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label" for="input-cart-products">{{ entry_cart_products }}</label>
            <div class="col-sm-10">
              <div class="abp-chips" id="input-cart-products" data-abp-ac="product" data-name="opt[cart_products][]">
                {% for id, name in cart_product_chips %}<span class="abp-chip"><span class="abp-chip-text">{{ name|e }}</span><input type="hidden" name="opt[cart_products][]" value="{{ id }}"/><button type="button" class="abp-chip-x" aria-label="{{ button_remove|e }}: {{ name|e }}">&times;</button></span>{% endfor %}
                <input type="text" class="abp-ac-input" placeholder="{{ text_autocomplete|e }}" autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-label="{{ entry_cart_products|e }}"/>
                <div class="abp-ac-menu" role="listbox" hidden></div>
              </div>
              <div id="error-opt-cart-products" class="invalid-feedback"></div>
            </div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label" for="input-cart-categories">{{ entry_cart_categories }}</label>
            <div class="col-sm-10">
              <div class="abp-chips" id="input-cart-categories" data-abp-ac="category" data-name="opt[cart_categories][]">
                {% for id, name in cart_category_chips %}<span class="abp-chip"><span class="abp-chip-text">{{ name|e }}</span><input type="hidden" name="opt[cart_categories][]" value="{{ id }}"/><button type="button" class="abp-chip-x" aria-label="{{ button_remove|e }}: {{ name|e }}">&times;</button></span>{% endfor %}
                <input type="text" class="abp-ac-input" placeholder="{{ text_autocomplete|e }}" autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-label="{{ entry_cart_categories|e }}"/>
                <div class="abp-ac-menu" role="listbox" hidden></div>
              </div>
              <span class="abp-help">{{ help_cart }}</span>
              <div id="error-opt-cart-categories" class="invalid-feedback"></div>
            </div>
          </div>
        </div>
      </div>

      {# ---------- Appearance ---------- #}
      <div class="card abp-card" id="abp-card-appearance">
        <div class="card-header"><span class="abp-card-title"><span class="abp-ico-badge"><i class="fa-solid fa-palette"></i></span> {{ text_section_appearance }}</span></div>
        <div class="card-body">
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_message_style }}</label>
            <div class="col-sm-10">
              <div class="abp-styles" role="radiogroup" aria-label="{{ entry_message_style|e }}">
                <div class="abp-style-opt">
                  <input type="radio" name="style" id="input-style-default" value=""{% if not style %} checked{% endif %}/>
                  <label for="input-style-default"><span class="abp-sw abp-sw-default"><i></i><b></b></span><span class="abp-name">{{ text_style_default|format(module_style)|e }}</span></label>
                </div>
                {% for item in styles %}
                  <div class="abp-style-opt">
                    <input type="radio" name="style" id="input-style-{{ item.value }}" value="{{ item.value }}"{% if style == item.value %} checked{% endif %}/>
                    <label for="input-style-{{ item.value }}"><span class="abp-sw abp-sw-{{ item.value }}"><i></i><b></b></span><span class="abp-name">{{ item.name|e }}</span><span class="abp-desc">{{ item.help|e }}</span></label>
                  </div>
                {% endfor %}
              </div>
              <div class="form-text">{{ help_style }}</div>
              <div id="error-style" class="invalid-feedback"></div>
            </div>
          </div>
          {% if color_auto %}<p class="abp-hint"><i class="fa-solid fa-wand-magic-sparkles"></i> {{ text_color_auto_note }}</p>{% endif %}
          {% for key in ['bg_color', 'text_color'] %}
            <div class="row mb-3 required">
              <label for="input-{{ key|replace({'_': '-'}) }}" class="col-sm-2 col-form-label">{{ attribute(_context, 'entry_' ~ key) }}</label>
              <div class="col-sm-10">
                <div class="input-group abp-color">
                  <input type="color" value="{{ attribute(_context, key)|e }}" class="form-control form-control-color" aria-label="{{ attribute(_context, 'entry_' ~ key)|e }}"/>
                  <input type="text" name="{{ key }}" value="{{ attribute(_context, key)|e }}" maxlength="7" id="input-{{ key|replace({'_': '-'}) }}" class="form-control"/>
                </div>
                <div id="error-{{ key|replace({'_': '-'}) }}" class="invalid-feedback"></div>
              </div>
            </div>
          {% endfor %}
          <div class="row mb-3">
            <label for="input-image" class="col-sm-2 col-form-label">{{ entry_image }}</label>
            <div class="col-sm-10">
              <div class="abp-image">
                <div class="card image" style="width:130px;">
                  <img src="{{ image_thumb|e }}" alt="" title="" id="thumb-image" data-oc-placeholder="{{ placeholder|e }}" class="card-img-top"/>
                  <input type="hidden" name="opt[image]" value="{{ opt.image|e }}" id="input-image"/>
                  <div class="card-body p-2">
                    <button type="button" data-oc-toggle="image" data-oc-target="#input-image" data-oc-thumb="#thumb-image" class="btn btn-primary btn-sm w-100 mb-1" aria-label="{{ entry_image|e }}"><i class="fa-solid fa-pencil"></i> {{ button_edit }}</button>
                    <button type="button" data-oc-toggle="clear" data-oc-target="#input-image" data-oc-thumb="#thumb-image" class="btn btn-warning btn-sm w-100"><i class="fa-regular fa-trash-can"></i> {{ button_clear }}</button>
                  </div>
                </div>
                <div class="abp-image-side" data-abp-show="opt[image]!=">
                  <label class="abp-sub-label" for="input-overlay">{{ entry_overlay }} <output id="abp-overlay-out">{{ opt.overlay }}</output>%</label>
                  <input type="range" min="0" max="90" step="5" name="opt[overlay]" value="{{ opt.overlay|e }}" id="input-overlay" class="form-range"/>
                </div>
              </div>
              <div class="form-text">{{ help_image }}</div>
              <div id="error-opt-image" class="invalid-feedback"></div>
              <div id="error-opt-overlay" class="invalid-feedback"></div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-font" class="col-sm-2 col-form-label">{{ entry_font }}</label>
            <div class="col-sm-10">
              <select name="opt[font]" id="input-font" class="form-select" style="max-width:320px;">
                <option value=""{% if opt.font == '' %} selected{% endif %}>{{ text_font_module }}</option>
                {% for f in font_list %}{% if f.value != '' %}<option value="{{ f.value }}"{% if opt.font == f.value %} selected{% endif %} style="font-family:{{ f.stack|e }}">{{ f.name|e }}</option>{% endif %}{% endfor %}
              </select>
              <div class="form-text">{{ help_font }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-sort-order" class="col-sm-2 col-form-label">{{ entry_sort_order }}</label>
            <div class="col-sm-10">
              <input type="number" name="sort_order" value="{{ sort_order|e }}" id="input-sort-order" class="form-control abp-num"/>
              <div id="error-sort-order" class="invalid-feedback"></div>
            </div>
          </div>
        </div>
      </div>
    </form>
  </div>
</div>
<script type="application/json" id="abp-config">{{ config_json }}</script>
<script type="text/javascript" src="{{ admin_js|e }}"></script>
{{ footer }}
