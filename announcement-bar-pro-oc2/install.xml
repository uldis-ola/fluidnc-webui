<?xml version="1.0" encoding="utf-8"?>
<modification>
  <name>Announcement Bar Pro</name>
  <code>announcement_bar_pro</code>
  <version>2.4.2</version>
  <author>3DP SIA</author>
  <link>mailto:extension@3dp.lv</link>
  <!--
    OpenCart 2.2.x / 2.3.x: no core file is changed — the bar is added by view events that the module registers when
    it is installed (Extensions › Modules › Install). The operation below then does nothing (the code checks the version
    and "skip" ignores it where the search text does not exist).
    OpenCart 2.0.x / 2.1.x have no view events: the template loader passes each finished storefront template to the
    module (header → bars, footer → fallback, cart / product / mini-cart → inline boxes). It only runs in the
    storefront, only while the module files exist, and never changes the output when the module is off or fails.
    After installing: Extensions › Modifications › Refresh.
  -->
  <file path="system/engine/loader.php">
    <operation error="skip">
      <search><![CDATA[ob_end_clean();]]></search>
      <add position="after"><![CDATA[
			// Announcement Bar Pro (OpenCart 2.0/2.1 storefront: the view hook OpenCart 2.2+ has as events)
			if (!defined('DIR_CATALOG') && version_compare(VERSION, '2.2.0.0', '<') && is_file(DIR_SYSTEM . 'library/announcementbarpro/oc2.php')) {
				require_once(DIR_SYSTEM . 'library/announcementbarpro/oc2.php');
				$output = AbpOc2::view($this->registry, isset($abp_view_template) && is_string($abp_view_template) ? $abp_view_template : $template, $output);
			}]]></add>
    </operation>
    <!-- The template name as the caller passed it: core's extract($data) and the template itself can overwrite $template. -->
    <operation error="skip">
      <search><![CDATA[extract($data);]]></search>
      <add position="before"><![CDATA[			$abp_view_template = $template; // Announcement Bar Pro: before extract($data) can overwrite $template]]></add>
    </operation>
  </file>
</modification>
