<div id="abp-bar" class="abp abp-pos-{{ position }}{% if sticky %} abp-sticky{% endif %} abp-mode-{{ mode }} abp-tr-{{ transition }}{% if dismissible %} abp-has-close{% endif %}{% if arrows %} abp-has-nav{% endif %}" role="region" aria-label="{{ label|e }}" data-days="{{ dismiss_days }}" data-interval="{{ interval }}" data-speed="{{ speed }}" data-mode="{{ mode }}" data-now="{{ now }}" data-tz="{{ tz }}" data-color="{{ color_mode }}" data-dismissible="{{ dismissible ? 1 : 0 }}" data-fallback="{{ fallback ? 1 : 0 }}" data-days-label="{{ days|e }}"{% if track %} data-track="{{ track|e }}"{% endif %}{% if cart %} data-cart="{{ cart|e }}"{% endif %} style="font-size:{{ font_size }}px;background-color:{{ items[0].bg_color }};color:{{ items[0].text_color }};">
  <div class="abp-viewport">
    <div class="abp-track">
      {% for item in items %}
      <div class="abp-item{% if loop.first %} abp-active{% endif %}" data-id="{{ item.id }}" data-key="{{ item.key|e }}" data-style="{{ item.style|e }}" data-c="{{ item.bg_color }}" data-t="{{ item.text_color }}"{% if item.device != 'all' %} data-device="{{ item.device|e }}"{% endif %}{% if item.end %} data-end="{{ item.end }}"{% endif %}{% if item.ab %} data-ab="1"{% endif %}{% if item.fs %} data-fs="1"{% if item.done %} data-done="1"{% endif %}{% endif %}{% if item.wd %} data-wd="{{ item.wd|e }}"{% endif %}{% if item.t1 %} data-t1="{{ item.t1|e }}" data-t2="{{ item.t2|e }}"{% endif %}{% if item.off %} data-off="1"{% endif %} style="background-color:{{ item.bg_color }};color:{{ item.text_color }};--abp-btn-bg:{{ item.text_color }};--abp-btn-fg:{{ item.bg_color }};--abp-accent:{{ item.text_color }};padding-top:{{ padding }}px;padding-bottom:{{ padding }}px;">
        <div class="abp-inner">
          {% for v in item.variants %}<span class="abp-v abp-v-{{ v.name|e }}">{% if v.wrap_link %}<a class="abp-link abp-body" href="{{ item.link|e }}"{% if item.new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}>{% else %}<span class="abp-body">{% endif %}{% if item.icon %}<i class="{{ item.icon|e }} abp-ico" aria-hidden="true"></i> {% endif %}<span class="abp-txt">{{ v.txt }}</span>{% if v.wrap_link %}</a>{% else %}</span>{% endif %}{% if item.link and v.link_text %}<a class="abp-btn abp-btn-{{ item.btn_style|e }}" href="{{ item.link|e }}"{% if item.new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ v.link_text|e }}</a>{% endif %}</span>{% endfor %}
          {% if item.coupon %}<span class="abp-coupon"><span class="abp-code">{{ item.coupon|e }}</span><button type="button" class="abp-copy" data-code="{{ item.coupon|e }}" data-label="{{ copy|e }}" data-copied="{{ copied|e }}" aria-label="{{ item.copy_aria|e }}"><svg class="abp-cp" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><rect x="5.2" y="5.2" width="8.6" height="8.6" rx="1.8" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M10.6 3.1V3A1.5 1.5 0 0 0 9.1 1.5H3A1.5 1.5 0 0 0 1.5 3v6.1a1.5 1.5 0 0 0 1.5 1.5h.1" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg><svg class="abp-ok" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M3 8.6l3.3 3.1L13 4.6" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="abp-copy-label">{{ copy|e }}</span></button><span class="abp-sr" role="status" aria-live="polite"></span></span>{% endif %}
        </div>
        {% if item.fs and item.progress %}<span class="abp-progress" aria-hidden="true" data-p="{{ item.pct }}"><span class="abp-progress-fill" style="width:{{ item.pct }}%;"></span></span>{% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
  {% if arrows %}<button type="button" class="abp-nav abp-prev" aria-label="{{ prev|e }}" title="{{ prev|e }}"><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M10 3 5 8l5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button><button type="button" class="abp-nav abp-next" aria-label="{{ next|e }}" title="{{ next|e }}"><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="m6 3 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button>{% endif %}
  {% if dismissible %}<button type="button" class="abp-close" aria-label="{{ close|e }}" title="{{ close|e }}"><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M3.5 3.5l9 9m0-9-9 9" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></button>{% endif %}
</div>
<script src="catalog/view/javascript/announcement_bar_pro/announcement_bar_pro_pre.js?v={{ version|e('url') }}"></script>
<link rel="stylesheet" href="catalog/view/javascript/announcement_bar_pro/announcement_bar_pro.css?v={{ version|e('url') }}" />
<script src="catalog/view/javascript/announcement_bar_pro/announcement_bar_pro.js?v={{ version|e('url') }}" defer></script>
