{% for c in containers %}
<div{% if c.id %} id="{{ c.id|e }}"{% endif %} class="abp {% if c.inline %}abp-inline abp-inline-{{ c.placement|e }}{% else %}abp-bar abp-pos-{{ c.placement|e }}{% endif %}{% if c.sticky %} abp-sticky{% endif %} abp-mode-{{ c.mode|e }} abp-tr-{{ transition|e }}{% if c.dismissible %} abp-has-close{% endif %}{% if c.arrows %} abp-has-nav{% endif %}{% if c.pause %} abp-has-pause{% endif %}{% if font %} abp-font-{{ font|e }}{% endif %}" data-abp="{{ c.inline ? 'inline' : 'bar' }}" data-place="{{ c.placement|e }}" role="region" aria-label="{{ label|e }}" data-days="{{ dismiss_days }}" data-interval="{{ interval }}" data-speed="{{ speed }}" data-mode="{{ c.mode|e }}" data-now="{{ now }}" data-tz="{{ tz }}" data-color="{{ color_mode|e }}" data-dismissible="{{ c.dismissible ? 1 : 0 }}" data-fallback="{{ fallback ? 1 : 0 }}" data-days-label="{{ days|e }}"{% if track %} data-track="{{ track|e }}"{% endif %}{% if cart %} data-cart="{{ cart|e }}"{% endif %}{% if max %} data-max="{{ max }}"{% endif %}{% if c.autohide %} data-autohide="{{ c.autohide }}" data-l-show="{{ show|e }}"{% endif %}{% if c.pause %} data-l-pause="{{ pause_label|e }}" data-l-play="{{ play_label|e }}"{% endif %}{% if ga4 %} data-ga="1"{% endif %} style="font-size:{{ font_size }}px;background-color:{{ c.items[0].bg_color }};color:{{ c.items[0].text_color }};">
  <div class="abp-viewport">
    <div class="abp-track">
      {% for item in c.items %}
      <div class="abp-item{% if loop.first %} abp-active{% endif %}" data-id="{{ item.id }}" data-key="{{ item.key|e }}" data-style="{{ item.style|e }}" data-c="{{ item.bg_color }}" data-t="{{ item.text_color }}"{% if item.device != 'all' %} data-device="{{ item.device|e }}"{% endif %}{% if item.end %} data-end="{{ item.end }}"{% endif %}{% if item.ab %} data-ab="1"{% endif %}{% if item.fs %} data-fs="1"{% if item.done %} data-done="1"{% endif %}{% endif %}{% if item.wd %} data-wd="{{ item.wd|e }}"{% endif %}{% if item.t1 %} data-t1="{{ item.t1|e }}" data-t2="{{ item.t2|e }}"{% endif %}{% if item.off %} data-off="1"{% endif %}{% if item.font %} data-font="{{ item.font|e }}"{% endif %}{% if item.image %} data-img="1"{% endif %}{% if item.utm %} data-utm="{{ item.utm|e }}"{% endif %}{% if item.vis %} data-vis="{{ item.vis|e }}"{% endif %}{% if item.utm or item.vis %} data-uoff="1"{% endif %}{% if item.trig %} data-trig="{{ item.trig|e }}" data-toff="1"{% endif %}{% if item.cc %} data-cc="1"{% if item.coff %} data-coff="1"{% endif %}{% endif %} style="background-color:{{ item.bg_color }};color:{{ item.text_color }};--abp-btn-bg:{{ item.text_color }};--abp-btn-fg:{{ item.bg_color }};--abp-accent:{{ item.text_color }};padding-top:{{ padding }}px;padding-bottom:{{ padding }}px;{{ item.image }}">
        <div class="abp-inner">
          {% for v in item.variants %}<span class="abp-v abp-v-{{ v.name|e }}">{% if v.wrap_link %}<a class="abp-link abp-body" href="{{ item.link|e }}"{% if item.new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}>{% else %}<span class="abp-body">{% endif %}{% if item.icon %}<i class="{{ item.icon|e }} abp-ico" aria-hidden="true"></i> {% endif %}<span class="abp-txt">{{ v.txt }}</span>{% if v.wrap_link %}</a>{% else %}</span>{% endif %}{% if item.link and v.link_text %}<a class="abp-btn abp-btn-{{ item.btn_style|e }}" href="{{ item.link|e }}"{% if item.new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ v.link_text|e }}</a>{% endif %}</span>{% endfor %}
          {% if item.coupon %}<span class="abp-coupon"><span class="abp-code">{{ item.coupon|e }}</span><button type="button" class="abp-copy" data-code="{{ item.coupon|e }}" data-label="{{ copy|e }}" data-copied="{{ copied|e }}" aria-label="{{ item.copy_aria|e }}"><svg class="abp-cp" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><rect x="5.2" y="5.2" width="8.6" height="8.6" rx="1.8" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M10.6 3.1V3A1.5 1.5 0 0 0 9.1 1.5H3A1.5 1.5 0 0 0 1.5 3v6.1a1.5 1.5 0 0 0 1.5 1.5h.1" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg><svg class="abp-ok" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M3 8.6l3.3 3.1L13 4.6" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="abp-copy-label">{{ copy|e }}</span></button><span class="abp-sr" role="status" aria-live="polite"></span></span>{% endif %}
          {% if item.email and subscribe %}<form class="abp-form" action="{{ subscribe|e }}" method="post" novalidate data-tok="{{ token|e }}" data-success="{{ item.email.success|e }}" data-sending="{{ sending|e }}" data-err-email="{{ err_email|e }}" data-err-consent="{{ err_consent|e }}" data-err-failed="{{ err_failed|e }}"><span class="abp-hp" aria-hidden="true"><label>Website <input type="text" name="website" value="" tabindex="-1" autocomplete="off" /></label></span><span class="abp-fields"><input type="email" name="email" class="abp-email" required="required" maxlength="96" autocomplete="email" inputmode="email" placeholder="{{ item.email.placeholder|e }}" aria-label="{{ item.email.placeholder|e }}" aria-describedby="abp-fm-{{ c.placement|e }}-{{ item.id }}" /><button type="submit" class="abp-submit">{{ item.email.button|e }}</button></span><label class="abp-consent"><input type="checkbox" name="consent" value="1" required="required" aria-describedby="abp-fm-{{ c.placement|e }}-{{ item.id }}" /> <span>{{ item.email.consent|e }}{% if privacy %} <a href="{{ privacy|e }}" target="_blank" rel="noopener">{{ privacy_text|e }}</a>{% endif %}</span></label><span class="abp-form-msg" id="abp-fm-{{ c.placement|e }}-{{ item.id }}" role="status" aria-live="polite"></span></form>{% endif %}
        </div>
        {% if item.fs and item.progress %}<span class="abp-progress{% if item.steps %} abp-steps{% endif %}" aria-hidden="true" data-p="{{ item.pct }}"{% if item.steps %} data-k="{{ item.k }}"{% endif %}><span class="abp-progress-fill" style="width:{{ item.pct }}%;"></span>{% for s in item.steps %}<span class="abp-step{% if s.done %} abp-step-done{% endif %}{% if loop.last %} abp-step-last{% endif %}" style="left:{{ s.at }}%;"><span class="abp-step-label">{{ s.label|e }}</span></span>{% endfor %}</span>{% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
  {% if c.pause %}<button type="button" class="abp-pause" aria-pressed="false" aria-label="{{ pause_label|e }}" title="{{ pause_label|e }}"><svg class="abp-i-pause" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M5.5 3.5v9m5-9v9" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg><svg class="abp-i-play" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M5 3.2v9.6L12.6 8z" fill="currentColor"/></svg></button>{% endif %}
  {% if c.arrows %}<button type="button" class="abp-nav abp-prev" aria-label="{{ prev|e }}" title="{{ prev|e }}"><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M10 3 5 8l5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button><button type="button" class="abp-nav abp-next" aria-label="{{ next|e }}" title="{{ next|e }}"><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="m6 3 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button>{% endif %}
  {% if c.dismissible %}<button type="button" class="abp-close" aria-label="{{ close|e }}" title="{{ close|e }}"><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M3.5 3.5l9 9m0-9-9 9" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></button>{% endif %}
</div>
{% endfor %}
{% if pre %}<script src="{{ base|e }}announcement_bar_pro_pre.js?v={{ version|e('url') }}"></script>
{% endif %}
{% if assets %}<link rel="stylesheet" href="{{ base|e }}announcement_bar_pro.css?v={{ version|e('url') }}" />
{% if custom_css %}<style id="abp-custom-css">{{ custom_css }}</style>
{% endif %}
<script src="{{ base|e }}announcement_bar_pro.js?v={{ version|e('url') }}" defer></script>
{% endif %}
