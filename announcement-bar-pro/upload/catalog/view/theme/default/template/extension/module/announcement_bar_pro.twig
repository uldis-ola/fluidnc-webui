<div id="abp-bar" class="abp abp-pos-{{ position }}{% if sticky %} abp-sticky{% endif %} abp-mode-{{ mode }}" role="region" aria-label="{{ label|e }}" data-hash="{{ hash|e }}" data-days="{{ dismiss_days }}" data-interval="{{ interval }}" data-speed="{{ speed }}" data-mode="{{ mode }}" data-days-label="{{ days|e }}" style="font-size:{{ font_size }}px;background-color:{{ items[0].bg_color }};color:{{ items[0].text_color }};">
  <div class="abp-viewport">
    <div class="abp-track">
      {% for item in items %}
      <div class="abp-item{% if loop.first %} abp-active{% endif %}" data-id="{{ item.id }}" style="background-color:{{ item.bg_color }};color:{{ item.text_color }};padding-top:{{ padding }}px;padding-bottom:{{ padding }}px;">
        {% if item.wrap_link %}<a class="abp-link" href="{{ item.link|e }}"{% if item.new_tab %} target="_blank" rel="noopener noreferrer"{% endif %} style="color:{{ item.text_color }};">{% endif %}
        {% if item.icon %}<i class="fa {{ item.icon }}" aria-hidden="true"></i> {% endif %}<span class="abp-text">{{ item.html }}</span>{% if item.countdown %} {{ item.countdown }}{% endif %}
        {% if item.wrap_link %}</a>{% endif %}
        {% if item.link and item.link_text %}<a class="abp-btn" href="{{ item.link|e }}"{% if item.new_tab %} target="_blank" rel="noopener noreferrer"{% endif %} style="color:{{ item.text_color }};border-color:{{ item.text_color }};">{{ item.link_text|e }}</a>{% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
  {% if dismissible %}<button type="button" class="abp-close" aria-label="{{ close|e }}" title="{{ close|e }}" style="color:{{ items[0].text_color }};">&times;</button>{% endif %}
</div>
<script>(function(){try{var b=document.getElementById('abp-bar'),h=b.getAttribute('data-hash'),n=Date.now();function ok(st){try{var v=JSON.parse(window[st].getItem('abp_dismiss')||'null');return !!v&&v.h===h&&(!v.t||v.t>n);}catch(e){return false;}}if(ok('localStorage')||ok('sessionStorage')){b.style.display='none';b.setAttribute('data-dismissed','1');}}catch(e){}})();</script>
<link rel="stylesheet" href="catalog/view/javascript/announcement_bar_pro/announcement_bar_pro.css?v={{ version|e('url') }}" />
<script src="catalog/view/javascript/announcement_bar_pro/announcement_bar_pro.js?v={{ version|e('url') }}" defer></script>
