{{ header }}{{ column_left }}
<div id="content" class="abp-admin">
  <link rel="stylesheet" href="{{ admin_css|e }}" />
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-settings" data-toggle="tooltip" title="{{ button_save|e }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel|e }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }} <small>v{{ version|e }}</small></h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    <div id="abp-alerts">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning|e }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if error_session %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_session|e }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if success %}
    <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success|e }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    </div>

    <ul class="nav nav-tabs">
      <li{% if active_tab == 'messages' %} class="active"{% endif %}><a href="#tab-messages" data-toggle="tab"><i class="fa fa-bullhorn"></i> {{ tab_messages }} <span class="badge">{{ messages|length }}</span></a></li>
      <li{% if active_tab == 'settings' %} class="active"{% endif %}><a href="#tab-settings" data-toggle="tab"><i class="fa fa-cog"></i> {{ tab_settings }}</a></li>
    </ul>

    <div class="tab-content">
      {# ---------------- Messages ---------------- #}
      <div class="tab-pane{% if active_tab == 'messages' %} active{% endif %}" id="tab-messages">
        <div class="panel panel-default abp-card">
          <div class="panel-heading clearfix">
            <div class="pull-left abp-card-title" style="padding-top:5px;"><span class="abp-ico-badge"><i class="fa fa-list"></i></span> {{ text_message_list }}</div>
            <div class="pull-right abp-toolbar">
              <a href="{{ export }}" data-toggle="tooltip" title="{{ help_export|e }}" class="btn btn-default btn-sm"><i class="fa fa-download"></i> {{ button_export }}</a>
              <button type="button" data-abp-import="{{ import }}" data-reload="{{ reload }}" data-toggle="tooltip" title="{{ help_import|e }}" class="btn btn-default btn-sm"><i class="fa fa-upload"></i> {{ button_import }}</button>
              <a href="{{ add }}" class="btn btn-primary btn-sm"><i class="fa fa-plus"></i> {{ button_add }}</a>
              <button type="button" data-toggle="tooltip" title="{{ button_delete|e }}" class="btn btn-danger btn-sm" id="abp-delete"><i class="fa fa-trash-o"></i></button>
            </div>
          </div>
          <div class="panel-body">
            {% if not setting.status %}
            <div class="alert alert-warning"><i class="fa fa-info-circle"></i> {{ text_module_disabled }}</div>
            {% endif %}
            <form action="{{ delete }}" method="post" id="form-delete">
              <div class="table-responsive">
                <table class="table table-hover abp-table">
                  <thead>
                    <tr>
                      <td style="width:1px;" class="text-center"><input type="checkbox" aria-label="{{ button_delete|e }}" onclick="$('input[name*=\'selected\']').prop('checked', this.checked);" /></td>
                      <td>{{ column_text }}</td>
                      <td class="text-center">{{ column_status }}</td>
                      <td class="hidden-xs hidden-sm">{{ column_period }}</td>
                      <td class="text-right"><span data-toggle="tooltip" title="{{ help_stats|e }}">{{ column_views }}</span></td>
                      <td class="text-right">{{ column_clicks }}</td>
                      <td class="text-right hidden-xs">{{ column_copies }}</td>
                      <td class="text-right">{{ column_ctr }}</td>
                      <td class="text-right" style="white-space:nowrap;">{{ column_action }}</td>
                    </tr>
                  </thead>
                  <tbody>
                    {% for message in messages %}
                    <tr data-message="{{ message.message_id }}">
                      <td class="text-center"><input type="checkbox" name="selected[]" value="{{ message.message_id }}" aria-label="{{ message.text|e }}" /></td>
                      <td>
                        <div class="abp-msg">
                          <span class="abp-swatch" style="background:{{ message.bg_color|e }};color:{{ message.text_color|e }};"><span class="abp-dot"></span>{{ message.text|e }}</span>
                          <div class="abp-badges">
                            {% if message.fs %}<span class="abp-badge abp-b-fs" data-toggle="tooltip" title="{{ message.fs|e }}"><i class="fa fa-truck"></i> {{ message.fs|e }}</span>{% endif %}
                            {% if message.coupon %}<span class="abp-badge abp-b-coupon" data-toggle="tooltip" title="{{ message.coupon|e }}"><i class="fa fa-ticket"></i> {{ message.coupon|e }}</span>{% endif %}
                            {% if message.ab %}<span class="abp-badge abp-b-ab" data-toggle="tooltip" title="{{ text_badge_ab|e }}"><i class="fa fa-random"></i> A/B</span>{% endif %}
                            {% if message.schedule %}<span class="abp-badge abp-b-schedule" data-toggle="tooltip" title="{{ message.schedule|e }}"><i class="fa fa-clock-o"></i> {{ message.schedule|e }}</span>{% endif %}
                            {% if message.targeting %}<span class="abp-badge abp-b-target" data-toggle="tooltip" title="{{ message.targeting|e }}"><i aria-hidden="true" class="fa fa-crosshairs"></i><span class="sr-only">{{ message.targeting|e }}</span></span>{% endif %}
                            {% if message.device != 'all' %}<span class="abp-badge" data-toggle="tooltip" title="{{ attribute(_context, 'text_device_' ~ message.device)|e }}"><i aria-hidden="true" class="fa {{ message.device == 'mobile' ? 'fa-mobile' : 'fa-desktop' }}"></i><span class="sr-only">{{ attribute(_context, 'text_device_' ~ message.device)|e }}</span></span>{% endif %}
                            {% if message.missing %}<span class="abp-badge abp-b-warn" data-toggle="tooltip" title="{{ message.missing|e }}"><i aria-hidden="true" class="fa fa-language"></i><span class="sr-only">{{ message.missing|e }}</span></span>{% endif %}
                          </div>
                        </div>
                      </td>
                      <td class="text-center"><span class="abp-state abp-state-{{ message.state|e }}">{{ message.state_text|e }}</span></td>
                      <td class="hidden-xs hidden-sm abp-muted" style="white-space:nowrap;">{{ message.date_start ? message.date_start|e : '—' }} → {{ message.date_end ? message.date_end|e : '∞' }}</td>
                      {% if message.ab %}
                      <td class="text-right abp-stats"><span class="abp-ctr"><span class="abp-ctr-v">A</span> {{ message.views }}</span><span class="abp-ctr"><span class="abp-ctr-v">B</span> {{ message.views_b }}</span></td>
                      <td class="text-right abp-stats"><span class="abp-ctr">{{ message.clicks }}</span><span class="abp-ctr">{{ message.clicks_b }}</span></td>
                      <td class="text-right abp-stats hidden-xs"><span class="abp-ctr">{{ message.copies }}</span><span class="abp-ctr">{{ message.copies_b }}</span></td>
                      <td class="text-right abp-stats"{% if not message.better %} title="{{ text_ab_waiting|e }}"{% endif %}>
                        <span class="abp-ctr{% if message.better == 'a' %} abp-win{% endif %}" data-abp-ctr="a"{% if message.better == 'a' %} data-toggle="tooltip" title="{{ text_ab_better|e }}"{% endif %}>{{ message.ctr != '' ? message.ctr|e ~ ' %' : '—' }}{% if message.better == 'a' %} <i class="fa fa-star abp-star"></i>{% endif %}</span>
                        <span class="abp-ctr{% if message.better == 'b' %} abp-win{% endif %}" data-abp-ctr="b"{% if message.better == 'b' %} data-toggle="tooltip" title="{{ text_ab_better|e }}"{% endif %}>{{ message.ctr_b != '' ? message.ctr_b|e ~ ' %' : '—' }}{% if message.better == 'b' %} <i class="fa fa-star abp-star"></i>{% endif %}</span>
                      </td>
                      {% else %}
                      <td class="text-right abp-stats">{{ message.views }}</td>
                      <td class="text-right abp-stats">{{ message.clicks }}</td>
                      <td class="text-right abp-stats hidden-xs">{{ message.copies }}</td>
                      <td class="text-right abp-stats">{{ message.ctr != '' ? message.ctr|e ~ ' %' : '—' }}</td>
                      {% endif %}
                      <td class="text-right abp-actions">
                        <a href="{{ message.edit }}" data-toggle="tooltip" title="{{ button_edit|e }}" class="btn btn-primary btn-sm"><i class="fa fa-pencil"></i></a>
                        {% if message.ab %}<button type="button" data-abp-use-b="{{ use_b }}" data-reload="{{ reload }}" data-id="{{ message.message_id }}" data-toggle="tooltip" title="{{ button_use_b|e }}" class="btn btn-success btn-sm abp-use-b"><i class="fa fa-trophy"></i> B</button>{% endif %}
                        <button type="button" data-abp-post="{{ duplicate }}" value="{{ message.message_id }}" data-toggle="tooltip" title="{{ button_duplicate|e }}" class="btn btn-default btn-sm abp-duplicate"><i class="fa fa-copy"></i></button>
                        <button type="button" data-abp-post="{{ reset }}" data-abp-confirm="1" value="{{ message.message_id }}" data-toggle="tooltip" title="{{ button_reset_stats|e }}" class="btn btn-warning btn-sm abp-reset"{% if not message.has_stats %} disabled="disabled"{% endif %}><i class="fa fa-eraser"></i></button>
                      </td>
                    </tr>
                    {% else %}
                    <tr>
                      <td class="abp-empty" colspan="9"><i class="fa fa-bullhorn"></i>{{ text_no_messages }}</td>
                    </tr>
                    {% endfor %}
                  </tbody>
                </table>
              </div>
            </form>
            <p class="help-block"><i class="fa fa-bar-chart"></i> {{ help_stats }}</p>
          </div>
        </div>
      </div>

      {# ---------------- Settings ---------------- #}
      <div class="tab-pane{% if active_tab == 'settings' %} active{% endif %} abp-settings" id="tab-settings">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-settings" class="form-horizontal">
          <div class="panel panel-default abp-card">
            <div class="panel-heading"><div class="abp-card-title"><span class="abp-ico-badge"><i class="fa fa-sliders"></i></span> {{ text_general }}</div></div>
            <div class="panel-body">
              <div class="form-group">
                <label class="col-sm-3 control-label" for="input-status">{{ entry_status }}</label>
                <div class="col-sm-9">
                  <select name="module_announcement_bar_pro_status" id="input-status" class="form-control abp-num">
                    <option value="1"{% if setting.status %} selected="selected"{% endif %}>{{ text_enabled }}</option>
                    <option value="0"{% if not setting.status %} selected="selected"{% endif %}>{{ text_disabled }}</option>
                  </select>
                  <span class="abp-help">{{ help_status }}</span>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-3 control-label" for="input-mode">{{ entry_mode }}</label>
                <div class="col-sm-9">
                  <select name="module_announcement_bar_pro_mode" id="input-mode" class="form-control">
                    {% for value in ['rotate', 'marquee', 'stack'] %}
                    <option value="{{ value }}"{% if setting.mode == value %} selected="selected"{% endif %}>{{ attribute(_context, 'text_mode_' ~ value) }}</option>
                    {% endfor %}
                  </select>
                  <span class="abp-help">{{ help_mode }}</span>
                  {% if error_settings.mode %}<div class="text-danger">{{ error_settings.mode|e }}</div>{% endif %}
                </div>
              </div>
              <div class="form-group" data-abp-show-mode="rotate">
                <label class="col-sm-3 control-label" for="input-interval">{{ entry_interval }}</label>
                <div class="col-sm-9">
                  <input type="number" min="2" max="60" name="module_announcement_bar_pro_interval" id="input-interval" value="{{ setting.interval|e }}" class="form-control abp-num" />
                  <span class="abp-help">{{ help_interval }}</span>
                  {% if error_settings.interval %}<div class="text-danger">{{ error_settings.interval|e }}</div>{% endif %}
                </div>
              </div>
              <div class="form-group" data-abp-show-mode="rotate">
                <label class="col-sm-3 control-label" for="input-transition">{{ entry_transition }}</label>
                <div class="col-sm-9">
                  <select name="module_announcement_bar_pro_transition" id="input-transition" class="form-control abp-num" style="max-width:220px;">
                    {% for value in ['fade', 'slide'] %}
                    <option value="{{ value }}"{% if setting.transition == value %} selected="selected"{% endif %}>{{ attribute(_context, 'text_transition_' ~ value) }}</option>
                    {% endfor %}
                  </select>
                  <span class="abp-help">{{ help_transition }}</span>
                  {% if error_settings.transition %}<div class="text-danger">{{ error_settings.transition|e }}</div>{% endif %}
                </div>
              </div>
              <div class="form-group" data-abp-show-mode="rotate">
                <label class="col-sm-3 control-label" for="input-arrows">{{ entry_arrows }}</label>
                <div class="col-sm-9">
                  <div class="checkbox"><label><input type="checkbox" name="module_announcement_bar_pro_arrows" id="input-arrows" value="1"{% if setting.arrows %} checked="checked"{% endif %} /> {{ text_yes }}</label></div>
                  <span class="abp-help">{{ help_arrows }}</span>
                </div>
              </div>
              <div class="form-group" data-abp-show-mode="marquee">
                <label class="col-sm-3 control-label" for="input-speed">{{ entry_speed }}</label>
                <div class="col-sm-9">
                  <input type="number" min="20" max="300" name="module_announcement_bar_pro_speed" id="input-speed" value="{{ setting.speed|e }}" class="form-control abp-num" />
                  <span class="abp-help">{{ help_speed }}</span>
                  {% if error_settings.speed %}<div class="text-danger">{{ error_settings.speed|e }}</div>{% endif %}
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-3 control-label" for="input-allow-html">{{ entry_allow_html }}</label>
                <div class="col-sm-9">
                  <div class="checkbox"><label><input type="checkbox" name="module_announcement_bar_pro_allow_html" id="input-allow-html" value="1"{% if setting.allow_html %} checked="checked"{% endif %} /> {{ text_yes }}</label></div>
                  <span class="abp-help">{{ help_allow_html }}</span>
                </div>
              </div>
            </div>
          </div>

          <div class="panel panel-default abp-card">
            <div class="panel-heading"><div class="abp-card-title"><span class="abp-ico-badge"><i class="fa fa-paint-brush"></i></span> {{ text_appearance }}</div></div>
            <div class="panel-body">
              <div class="form-group">
                <label class="col-sm-3 control-label">{{ entry_style }}</label>
                <div class="col-sm-9">
                  <div class="abp-styles" role="radiogroup" aria-label="{{ entry_style|e }}">
                    {% for style in styles %}
                    <div class="abp-style-opt">
                      <input type="radio" name="module_announcement_bar_pro_style" id="input-style-{{ style.value }}" value="{{ style.value }}"{% if setting.style == style.value %} checked="checked"{% endif %} />
                      <label for="input-style-{{ style.value }}"><span class="abp-sw abp-sw-{{ style.value }}"><i></i><b></b></span><span class="abp-name">{{ style.name|e }}</span><span class="abp-desc">{{ style.help|e }}</span></label>
                    </div>
                    {% endfor %}
                  </div>
                  <span class="abp-help">{{ help_style }}</span>
                  {% if error_settings.style %}<div class="text-danger">{{ error_settings.style|e }}</div>{% endif %}
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-3 control-label" for="input-color-mode">{{ entry_color_mode }}</label>
                <div class="col-sm-9">
                  <select name="module_announcement_bar_pro_color_mode" id="input-color-mode" class="form-control">
                    <option value="auto"{% if setting.color_mode == 'auto' %} selected="selected"{% endif %}>{{ text_color_auto }}</option>
                    <option value="custom"{% if setting.color_mode != 'auto' %} selected="selected"{% endif %}>{{ text_color_custom }}</option>
                  </select>
                  <span class="abp-help">{{ help_color_mode }}</span>
                  {% if error_settings.color_mode %}<div class="text-danger">{{ error_settings.color_mode|e }}</div>{% endif %}
                </div>
              </div>
              {% for key in ['default_bg_color', 'default_text_color'] %}
              <div class="form-group">
                <label class="col-sm-3 control-label" for="input-{{ key }}">{{ attribute(_context, 'entry_' ~ key) }}</label>
                <div class="col-sm-9">
                  <div class="input-group abp-color">
                    <span class="input-group-addon"><input type="color" value="{{ attribute(setting, key)|e }}" aria-label="{{ attribute(_context, 'entry_' ~ key)|e }}" /></span>
                    <input type="text" name="module_announcement_bar_pro_{{ key }}" id="input-{{ key }}" value="{{ attribute(setting, key)|e }}" maxlength="7" class="form-control" />
                  </div>
                  <span class="abp-help">{{ help_default_color }}</span>
                  {% if attribute(error_settings, key) is defined %}<div class="text-danger">{{ attribute(error_settings, key)|e }}</div>{% endif %}
                </div>
              </div>
              {% endfor %}
              <div class="form-group">
                <label class="col-sm-3 control-label" for="input-position">{{ entry_position }}</label>
                <div class="col-sm-9">
                  <select name="module_announcement_bar_pro_position" id="input-position" class="form-control">
                    <option value="top"{% if setting.position == 'top' %} selected="selected"{% endif %}>{{ text_position_top }}</option>
                    <option value="bottom"{% if setting.position == 'bottom' %} selected="selected"{% endif %}>{{ text_position_bottom }}</option>
                  </select>
                  <span class="abp-help">{{ help_position }}</span>
                  {% if error_settings.position %}<div class="text-danger">{{ error_settings.position|e }}</div>{% endif %}
                </div>
              </div>
              <div class="form-group" id="abp-sticky-group">
                <label class="col-sm-3 control-label" for="input-sticky">{{ entry_sticky }}</label>
                <div class="col-sm-9">
                  <div class="checkbox"><label><input type="checkbox" name="module_announcement_bar_pro_sticky" id="input-sticky" value="1"{% if setting.sticky %} checked="checked"{% endif %} /> {{ text_yes }}</label></div>
                  <span class="abp-help">{{ help_sticky }}</span>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-3 control-label" for="input-font-size">{{ entry_font_size }}</label>
                <div class="col-sm-9">
                  <input type="number" min="10" max="30" name="module_announcement_bar_pro_font_size" id="input-font-size" value="{{ setting.font_size|e }}" class="form-control abp-num" />
                  <span class="abp-help">{{ help_font_size }}</span>
                  {% if error_settings.font_size %}<div class="text-danger">{{ error_settings.font_size|e }}</div>{% endif %}
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-3 control-label" for="input-padding">{{ entry_padding }}</label>
                <div class="col-sm-9">
                  <input type="number" min="0" max="30" name="module_announcement_bar_pro_padding" id="input-padding" value="{{ setting.padding|e }}" class="form-control abp-num" />
                  <span class="abp-help">{{ help_padding }}</span>
                  {% if error_settings.padding %}<div class="text-danger">{{ error_settings.padding|e }}</div>{% endif %}
                </div>
              </div>
            </div>
          </div>

          <div class="panel panel-default abp-card">
            <div class="panel-heading"><div class="abp-card-title"><span class="abp-ico-badge"><i class="fa fa-times-circle"></i></span> {{ text_dismiss }}</div></div>
            <div class="panel-body">
              <div class="form-group">
                <label class="col-sm-3 control-label" for="input-dismissible">{{ entry_dismissible }}</label>
                <div class="col-sm-9">
                  <div class="checkbox"><label><input type="checkbox" name="module_announcement_bar_pro_dismissible" id="input-dismissible" value="1"{% if setting.dismissible %} checked="checked"{% endif %} /> {{ text_yes }}</label></div>
                  <span class="abp-help">{{ help_dismissible }}</span>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-3 control-label" for="input-dismiss-days">{{ entry_dismiss_days }}</label>
                <div class="col-sm-9">
                  <input type="number" min="0" max="365" name="module_announcement_bar_pro_dismiss_days" id="input-dismiss-days" value="{{ setting.dismiss_days|e }}" class="form-control abp-num" />
                  <span class="abp-help">{{ help_dismiss_days }}</span>
                  {% if error_settings.dismiss_days %}<div class="text-danger">{{ error_settings.dismiss_days|e }}</div>{% endif %}
                </div>
              </div>
            </div>
          </div>

          <div class="panel panel-default abp-card">
            <div class="panel-heading"><div class="abp-card-title"><span class="abp-ico-badge"><i class="fa fa-wrench"></i></span> {{ text_advanced }}</div></div>
            <div class="panel-body">
              <div class="form-group">
                <label class="col-sm-3 control-label" for="input-delete-data">{{ entry_delete_data }}</label>
                <div class="col-sm-9">
                  <div class="checkbox"><label><input type="checkbox" name="module_announcement_bar_pro_delete_data" id="input-delete-data" value="1"{% if setting.delete_data %} checked="checked"{% endif %} /> {{ text_yes }}</label></div>
                  <span class="abp-help">{{ help_delete_data }}</span>
                </div>
              </div>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
<script type="application/json" id="abp-config">{{ config_json }}</script>
<script type="text/javascript" src="{{ admin_js|e }}"></script>
<script type="text/javascript"><!--
(function ($) {
  var hex = /^#[0-9a-fA-F]{6}$/;

  // Duplicate / reset: plain buttons that POST their own small form. They must not be type="submit":
  // OpenCart 3 admin common.js submits every form-* on the page when any submit button is clicked.
  // One request only (a double click must not create two copies).
  var abpSent = false;
  $('[data-abp-post]').on('click', function () {
    if (abpSent || this.disabled) { return; }
    if ($(this).data('abp-confirm') && !confirm('{{ text_confirm_reset|e('js') }}')) { return; }
    abpSent = true;
    $(this).prop('disabled', true);
    var f = $('<form method="post" style="display:none"></form>').attr('action', $(this).data('abp-post'));
    f.append($('<input type="hidden" name="message_id">').val(this.value));
    $('body').append(f);
    f.get(0).submit();
  });

  $('.abp-color').each(function () {
    var picker = $(this).find('input[type=color]'), text = $(this).find('input[type=text]');
    picker.on('input change', function () { text.val(this.value); });
    text.on('input change', function () { if (hex.test(this.value)) { picker.val(this.value); } });
  });

  function toggle() {
    var mode = $('#input-mode').val();
    $('[data-abp-show-mode]').each(function () { $(this).toggle($(this).data('abp-show-mode') === mode); });
    $('#abp-sticky-group').toggle($('#input-position').val() === 'top');
  }
  $('#input-mode, #input-position').on('change', toggle);
  toggle();

  $('#abp-delete').on('click', function () {
    if (!$('#form-delete input[name="selected[]"]:checked').length) { return; }
    if (confirm('{{ text_confirm|e('js') }}')) { $('#form-delete').submit(); }
  });
})(jQuery);
//--></script>
{{ footer }}
